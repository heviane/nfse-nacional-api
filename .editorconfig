# EditorConfig: https://editorconfig.org
root = true

# Padrão Global para todos os arquivos
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Código-fonte Java (Convenção Oficial: 4 espaços)
[*.java]
indent_style = space
indent_size = 4

# Arquivos Fiscais, Schemas e Configurações XML (2 espaços)
[*.{xml,xsd,wsdl}]
indent_style = space
indent_size = 2
charset = utf-8

# Arquivos de Configuração JSON e YAML (2 espaços)
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Arquivos de Propriedades do Java
[*.properties]
indent_style = space
indent_size = 2
charset = utf-8

# Scripts de Shell e Terminal
[*.{sh,bash}]
end_of_line = lf
indent_style = space
indent_size = 2

# Scripts PowerShell
[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_style = space
indent_size = 4

# Documentação Markdown (preserva espaços no final para quebras de linha)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
