# ==============================================================================
# SCRIPT DE EXEMPLO PARA INICIALIZAÇÃO LOCAL (WINDOWS POWERSHELL)
# ==============================================================================
# SEGURANÇA FISCAL:
# O arquivo real 'run-local.ps1' está blindado pelo .gitignore do repositório
# para assegurar que caminhos de certificados, senhas e chaves privadas locais
# NUNCA sejam comitados no controle de versão Git.
#
# INSTRUÇÕES DE USO:
# 1. Copie este arquivo para 'run-local.ps1' (ou 'scripts/run-local.ps1').
# 2. Preencha o caminho do seu arquivo .pfx e a respectiva senha.
# 3. Certifique-se de ter gerado o pacote WAR via: mvn clean package -DskipTests
# 4. Execute: .\scripts\run-local.ps1 (ou .\run-local.ps1)
# ==============================================================================

# Caminho do certificado digital A1 (.pfx ou .p12)
$PfxPath = "C:\caminho\seu_certificado.pfx"

# Senha de proteção do certificado digital
$PfxPassword = "sua_senha_aqui"

# Ambiente: HOMOLOGACAO ou PRODUCAO (Padrão de segurança: HOMOLOGACAO)
$EnvSefin = "HOMOLOGACAO"

# Porta HTTP do servidor local (Padrão: 8080)
$Port = "8080"

# Chave secreta de API opcional (caso deseje testar com autenticação ativada)
$ApiKey = ""

# ------------------------------------------------------------------------------
# Processamento e inicialização (não precisa alterar abaixo)
# ------------------------------------------------------------------------------
# Resolução dinâmica da raiz do projeto (suporta execução da raiz ou da pasta scripts/)
$ProjectRoot = if (Test-Path "$PSScriptRoot\..\pom.xml") {
    (Resolve-Path "$PSScriptRoot\..").Path
} elseif (Test-Path "pom.xml") {
    (Get-Location).Path
} else {
    $PSScriptRoot
}

if (-not (Test-Path $PfxPath)) {
    Write-Error "Arquivo de certificado não encontrado em: $PfxPath"
    Write-Host "Configure a variável `$PfxPath com o caminho absoluto do seu certificado A1 (.pfx/.p12)." -ForegroundColor Yellow
    exit 1
}

$WarPath = Join-Path $ProjectRoot "target\nfse-nacional-api.war"
if (-not (Test-Path $WarPath)) {
    Write-Warning "Artefato WAR não encontrado em: $WarPath"
    Write-Host "O pacote WAR precisa ser gerado antes da execução." -ForegroundColor Yellow
    Write-Host "Execute no terminal: mvn clean package -DskipTests" -ForegroundColor Cyan
    exit 1
}

Write-Host "Convertendo certificado A1 para Base64 em memória..." -ForegroundColor Cyan
$certBytes = [System.IO.File]::ReadAllBytes($PfxPath)
$env:NFSE_CERT_BASE64 = [Convert]::ToBase64String($certBytes)
$env:NFSE_CERT_PASSWORD = $PfxPassword
$env:NFSE_ENVIRONMENT = $EnvSefin
$env:SERVER_PORT = $Port

if ($ApiKey -ne "") {
    $env:NFSE_API_KEY = $ApiKey
    Write-Host "Autenticação por API Key ativada: $env:NFSE_API_KEY" -ForegroundColor Green
}

Write-Host "Variáveis de ambiente configuradas com sucesso!" -ForegroundColor Green
Write-Host "Ambiente Sefin: $env:NFSE_ENVIRONMENT" -ForegroundColor Green
Write-Host "Porta: $env:SERVER_PORT" -ForegroundColor Green
Write-Host "Iniciando nfse-nacional-api ($WarPath)..." -ForegroundColor Yellow

java -jar $WarPath


