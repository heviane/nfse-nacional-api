{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/target": true,
    "**/.gradle": true,
    "**/.settings": true,
    "**/.classpath": true,
    "**/.project": true
  }
}
