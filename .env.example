# ==============================================================================
# CONFIGURAÇÕES DO SERVIÇO NFS-E NACIONAL API (EXEMPLO)
# Copie este arquivo para .env ou configure diretamente no seu terminal local.
# ATENÇÃO: NUNCA envie o arquivo .env preenchido ou dados reais de clientes ao Git!
# ==============================================================================

# Ambiente de destino do Sefin Nacional: HOMOLOGACAO ou PRODUCAO (Padrão de segurança: HOMOLOGACAO)
NFSE_ENVIRONMENT=HOMOLOGACAO

# Porta HTTP do servidor da aplicação (Padrão: 8080)
SERVER_PORT=8080

# Certificado Digital ICP-Brasil A1 (.pfx / .p12):
# Opção 1 (Recomendada para Tomcat/Servidores): Caminho absoluto do arquivo no disco com permissão 600
# NFSE_CERT_PATH=/opt/certs/certificado.pfx
NFSE_CERT_PATH=

# Opção 2 (Alternativa para containers Docker/K8s): Arquivo codificado em Base64
# Para gerar no PowerShell (Windows):
#   [Convert]::ToBase64String([System.IO.File]::ReadAllBytes("C:\caminho\seu_certificado.pfx"))
# Para gerar no Linux/macOS:
#   base64 -w 0 /caminho/seu_certificado.pfx
NFSE_CERT_BASE64=

# Senha de proteção do Certificado Digital A1
NFSE_CERT_PASSWORD=

# Chave secreta de autenticação da API / WebService (Opcional, se isolado por firewall de IP)
NFSE_API_KEY=

# Permite envio de certificado via headers HTTP (X-Certificado-Base64) - Padrão de segurança: false
NFSE_ALLOW_CERT_HEADERS=false

